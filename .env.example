# 必填、客户端公开、构建时嵌入。仅填写 Supabase 项目 URL，不得包含任何密钥。
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# 必填、客户端公开、构建时嵌入。只能使用 publishable key，不得使用 service role key。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# 必填、客户端公开、构建时嵌入。填写员工能从浏览器访问的最终部署 origin，用于生成飞书任务深链。
NEXT_PUBLIC_APP_URL=https://workstation.example.com

# 宿主机端口已在 compose.yaml 固定为 3010:3000，不再使用 APP_PORT 环境变量。

# 启用飞书登录时必填、运行时读取。Tenant Key 是服务端配置，不得添加 NEXT_PUBLIC_ 前缀。
FEISHU_TENANT_KEY=tenant_key_from_feishu_admin
# 必填、服务端运行时读取。通知服务使用飞书 App ID，不得添加 NEXT_PUBLIC_ 前缀。
FEISHU_APP_ID=cli_your_feishu_app_id
# 必填、仅服务端、仅运行时读取。不得添加 NEXT_PUBLIC_ 前缀、用作构建参数或发送到客户端。
FEISHU_APP_SECRET=your_server_only_feishu_app_secret
# 必填、仅服务端、仅运行时读取。不得添加 NEXT_PUBLIC_ 前缀、用作构建参数或发送到客户端。
SUPABASE_SERVICE_ROLE_KEY=your_server_only_supabase_service_role_key
# 薪资自动核算不新增任何密钥。正式核算复用以上 Supabase 服务端凭据读取版本化费率政策并保存计算快照。
# 严禁创建 NEXT_PUBLIC_PAYROLL_* 或把员工工资、社保、个税数据写入环境变量；这些数据只能进入受 RLS 保护的数据库。
# 必填、服务端秘密、运行时读取。必须是32字节随机值的Base64编码，用于加密模型API Key。
AI_CONFIG_ENCRYPTION_KEY=base64_encoded_32_byte_random_key

# 必填、仅服务端、仅运行时读取。Docker Compose 的受保护定时 worker 每五分钟调用 Agent 调用恢复端点；至少 32 个字符，绝不使用 NEXT_PUBLIC_ 前缀。
AGENT_INVOCATION_RECOVERY_CRON_SECRET=replace_with_a_long_random_server_only_secret
TASK_NOTIFICATION_RECOVERY_CRON_SECRET=replace_with_a_different_long_random_server_only_secret

# 必填、仅服务端、仅运行时读取。Docker Compose 定时清理未完成或核验失败的对象；至少 32 个字符，绝不使用 NEXT_PUBLIC_ 前缀。
FILE_UPLOAD_CLEANUP_CRON_SECRET=replace_with_another_long_random_server_only_secret

# 必填、仅服务端、仅运行时读取。保护知识库扫描、解析和向量化 worker 入口；至少 32 个字符。
INTERNAL_WORKER_TOKEN=replace_with_a_unique_long_random_server_only_secret
# 必填、仅服务端、仅运行时读取。HTTPS 文档处理服务及其鉴权；服务域名必须同时列入白名单。
KNOWLEDGE_PROCESSOR_URL=https://processor.example.com/v1/knowledge/jobs
KNOWLEDGE_PROCESSOR_SECRET=replace_with_a_processor_specific_server_only_secret
# 逗号分隔的精确小写主机名，不支持通配符；处理器 DNS 解析到私网、回环或链路本地地址时请求会被拒绝。
KNOWLEDGE_PROCESSOR_ALLOWED_HOSTS=processor.example.com

# 生产默认必须为 false。只有本地演示/验收环境才允许显式改成 true。
WORKSTATION_ALLOW_MOCK_DATA=false

# 可选、脚本专用秘密。仅供 Supabase CLI 远程 migration 使用，不传入生产容器。
SUPABASE_DB_URL=postgresql://postgres:your_database_password@db.your_project_ref.supabase.co:5432/postgres
# 可选、脚本专用路径。仅本地名单导入脚本读取，不传入生产容器。
PHASE1_ROSTER_PATH=private/phase1-roster.json

# 生产默认必须为 false。只有内部演示环境才允许显式改成 true。
WORKSTATION_DEMO_ENABLED=false
# 可选、运行时读取。未填写时默认使用 admin；仅在 WORKSTATION_DEMO_ENABLED=true 时生效。
WORKSTATION_DEMO_USERNAME=admin
# 可选、服务端秘密、运行时读取。仅在 WORKSTATION_DEMO_ENABLED=true 时必填。
WORKSTATION_DEMO_PASSWORD=replace_with_a_strong_password
# 可选、运行时读取。仅在 WORKSTATION_DEMO_ENABLED=true 时必填，必须填写当前租户的非零 UUID。
WORKSTATION_DEMO_TENANT_ID=your_tenant_public_id_uuid

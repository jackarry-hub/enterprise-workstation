{
  "name": "enterprise-workstation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:html",
    "test:unit": "vitest run --exclude \"scripts/phase1/**/*.test.mjs\" --exclude \"scripts/phase2/**/*.test.mjs\" --exclude \"tests/html-*.test.mjs\" --exclude \".worktrees/**\"",
    "test:html": "node --test tests/html-fusion-contract.test.mjs tests/html-demo-login-behavior.test.mjs tests/html-personal-workbench-behavior.test.mjs tests/html-workstation-server-adapter.test.mjs",
    "test:watch": "vitest --exclude \"scripts/phase1/**/*.test.mjs\" --exclude \"scripts/phase2/**/*.test.mjs\" --exclude \"tests/html-*.test.mjs\" --exclude \".worktrees/**\"",
    "test:e2e": "playwright test",
    "db:start": "npx supabase start",
    "db:reset:test": "node scripts/db-command-runner.mjs db:reset:test --environment Local --database-url postgresql://postgres:postgres@127.0.0.1:54322/postgres",
    "db:migrate:dry-run": "node scripts/db-command-runner.mjs db:migrate:dry-run --environment Local --database-url postgresql://postgres:postgres@127.0.0.1:54322/postgres",
    "db:test": "node scripts/db-command-runner.mjs db:test --environment Local --database-url postgresql://postgres:postgres@127.0.0.1:54322/postgres",
    "db:seed:validate": "node scripts/db-command-runner.mjs db:seed:validate --environment Local --database-url postgresql://postgres:postgres@127.0.0.1:54322/postgres",
    "db:rollback:test": "node scripts/db-command-runner.mjs db:rollback:test --environment Local --database-url postgresql://postgres:postgres@127.0.0.1:54322/postgres",
    "test:coverage": "node scripts/phase-gates.mjs coverage",
    "test:security": "node scripts/phase-gates.mjs security",
    "test:rls": "node scripts/phase-gates.mjs rls --environment Local --database-url postgresql://postgres:postgres@127.0.0.1:54322/postgres",
    "phase1:provision": "node scripts/phase1/provision-roster.mjs",
    "phase1:provision:test": "node --test scripts/phase1/provision-roster.test.mjs",
    "phase1:verify": "npm run phase1:provision:test && npm test && npm run typecheck && npm run lint && npm run build",
    "phase2:config:test": "node --test scripts/phase2/*.test.mjs",
    "phase2:check": "node scripts/phase2/supabase-command.mjs check",
    "phase2:dry-run": "node scripts/phase2/supabase-command.mjs dry-run",
    "phase2:push": "node scripts/phase2/supabase-command.mjs push",
    "phase2:db-test": "node scripts/phase2/supabase-command.mjs db-test",
    "phase2:verify": "node scripts/phase2/verify-remote.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "15.5.22",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@next/env": "15.5.22",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "sharp": "0.35.0"
  }
}
